# ========================================================================
# ID Maker — Environment Configuration Template (.env.example)
# ========================================================================
# Copy this file to .env.local for local testing or configure these variables
# directly in Vercel's Project Settings > Environment Variables for Production & Preview.
#
# IMPORTANT:
# - All frontend variables must start with VITE_ to be bundled by Vite.
# - Do not commit real private keys or service account credentials to Git.
# ========================================================================

# 1. PUBLIC APPLICATION URL (CRITICAL FOR PRODUCTION QR VERIFICATION)
# The public HTTPS URL where ID Maker is hosted (e.g., https://idmaker.vercel.app or custom domain).
# Physical QR codes generated on ID cards and exported PDFs will encode this URL.
VITE_PUBLIC_APP_URL="https://your-app-name.vercel.app"

# 2. FIREBASE CLIENT CONFIGURATION
# Found in Firebase Console > Project Settings > General > Your Apps (Web).
# Client credentials are safe for public browser bundling and are protected by
# Firestore Security Rules and Storage Security Rules.
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID=""

# 3. NAMED FIRESTORE DATABASE ID
# Set if your Firebase project uses a named database rather than '(default)'
VITE_FIREBASE_DATABASE_ID="ai-studio-idmaker-a4999d07-3303-4710-b0a3-12a5abb47851"

# 4. OPTIONAL AI & INTERNAL RUNTIME
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://your-app-name.vercel.app"
